# ---- app ----
APP_URL=http://localhost:3000

# ---- Discord (server-side only — never expose to the browser) ----
DISCORD_WEBHOOK_URL=

# ---- Google Sheets (data store) ----
GOOGLE_JSON_KEY=
GOOGLE_CREDENTIALS_FILE=
SHEET_ID=

# ---- database (Postgres) — สำหรับอนาคต ----
DATABASE_URL=

# ---- upload target (MB) ----
UPLOAD_TARGET_MB=19

# ---- performance ----
# จำนวนคลิปที่ตัดต่อพร้อมกัน (1 = ประหยัด CPU, 2-4 = เร็วขึ้นถ้าเครื่องมีหลาย core)
FFMPEG_CONCURRENCY=1
